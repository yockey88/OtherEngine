vertex [mesh : position_only] {

  uniform mat4 model;

  void main() {
    vec4 world_pos = projection * view * model * vec4(voe_position, 1);
    world_pos = world_pos * (1.0 / world_pos.w);

    gl_Position = world_pos;
  }

}

fragment {

  out vec4 FragColor;

  void main() {
    FragColor = vec4(0, 0, 1, 1);
  }

}