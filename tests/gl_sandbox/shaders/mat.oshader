vertex [mesh : default] {

  void main() {
    instanceid = gl_InstanceID;
    mat4 model = models[gl_InstanceID];
    gl_Position = projection * view * model * vec4(voe_position, 1.0);
  }

}

fragment {

  out vec4 FragColor;

  void main() {
    vec4 color = texture(albedo_textures, vec3(foe_uvs, instanceid));
    FragColor = color;
  }

}