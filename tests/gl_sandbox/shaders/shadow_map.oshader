vertex [mesh : default] {

  void main() {
    gl_Position = direction_light.light_space_matrix * models[gl_InstanceID] * vec4(voe_position, 1.0);
  }  

}

fragment {

  out vec4 FragColor;

  float near = 0.1;
  float far = 100.0;

  float LinearizeDepth(float depth) {
    float z = depth * 2.0 - 1.0;
    return (2.0 * near * far) / (far + near - z * (far - near));
  }

  void main() {
    // float depth = LinearizeDepth(gl_FragCoord.z);
    FragColor = vec4(vec3(gl_FragCoord.z), 1.0);
  }

}