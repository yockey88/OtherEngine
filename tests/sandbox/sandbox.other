[project]
name = "Sandbox"
working-directory = "C:/Yock/code/OtherEngine/tests/sandbox"
bin-dir = "C:/Yock/code/OtherEngine/bin/Debug"
script-bin-dir = "SandboxScripts/net8.0"
author = "Y"
version = 0.0.1
primary-scene = test_scene
scenes = {
  "test_scene",
  "test_scene2"
}

[debug]
editor = true

[window]
width = 800
height = 600
title = "Other Engine Sandbox"

[renderer]
cull-face = false

[log]
console-level = "debug" 
file-level = "trace"
path = "./logs/sandbox.log"

[script-engine.C#]
attachments = { 
  scene = { "SandboxScripts.dll" }
}

[script-engine.Lua]
attachments = {
  ui = { "sandbox_ui.lua" }
}

[attachments]
ui = { 
  *sandbox_ui = { "SandboxUI" }
}

@framebuffer [final-frame] = {
  FinalFrame
  depth-function = LESS
  clear-color = {
    1, 1, 1, 1
  }
  size = {1920,1080}
  depth-buffer = true
  color-buffer = true
  stencil-buffer = false
}