  static-mesh
}

[floor.transform]
position = { 0 , -2 , 0 }
rotation = { 0 , 0 , 0 , 1 }
scale = { 10 , 1 , 10 }

[floor.relationship]
children = {}

[floor.static-mesh]
visible = true
is-primitive = true
primitive = 3
material.color = { 0.1, 0.5, 0.31, 1 }
material.shininess = 32

[camera]
UUID = 4220486183894562136
components = {
  camera
}

[camera.transform]
position = { 0 , 0 , 3 }
rotation = { 0 , 0 , 0 , 1 }
scale = { 1 , 1 , 1 }

[camera.relationship]
children = {}

[camera.camera]
type = perspective
position = { 0 , 0 , 3 }
direction = { 0 , 0 , -1 }
up = { 0 , 0 , 1 }
world-up = { 0 , 1 , 0 }
right = { 0 , 0 , 1 }
rotation = { 0 , 0 , 0 }
viewport = { 1920 , 1080 } 
clip = { 0.1 , 10000 }
speed = 0.1
sensitivity = 0.2
fov = 75
zoom = 45
constrain-pitch = true
primary = true
pinned = true


