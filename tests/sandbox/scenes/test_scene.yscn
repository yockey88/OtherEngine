#[
  primary sandbox scene
#]

[metadata]
name = "test_scene"
entities = {
  "cube" ,
  "sun" ,
  "floor",
  "entity",
  "camera"
}


[physics.2D]
gravity = { 0 , -9.8 }

[physics.3D]


[cube]
UUID = 12461263173642597452
components = {
  static-mesh , 
  script
}

[cube.transform]
position = { 0 , 0 , 0 }
rotation = { 0 , 0 , 0 , 0 }
scale = { 1 , 1 , 1 }

[cube.relationship]
children = {}

[cube.static-mesh]
visible = true
is-primitive = true
primitive = 3
material.color = { 1.0, 0.5, 0.31, 1 }
material.shininess = 32

[cube.script]
*SandboxScripts = { "Other::TestScript2" }

[sun]
UUID = 4025795962345870502
components = {
  light-source
}

[sun.transform]
