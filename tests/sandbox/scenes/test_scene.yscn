material.normal = { 1.0 , 1.0 , 1.0, 1 }
material.roughness = { 1.0, 1.0, 1.0, 1 }

[floor.script]
*SandboxScripts = { "Other::TestScript2" }

[floor.rigid-body]
type = static

[floor.collider]
shape = box

[camera]
UUID = 4220486183894562136
components = {
  camera
}

[camera.transform]
position = { 0 , 0 , 3 }
rotation = { 0 , 0 , 0 , 1 }
scale = { 1 , 1 , 1 }

[camera.relationship]
children = {}

[camera.camera]
