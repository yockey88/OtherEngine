rotation = { 0 , 0 , 0 , 0 }
scale = { 0.2 , 0.2 , 0.2 }

[sun.light-source]
type = 1
direction = { 0 , -1.0 , 0 , 1.0 }
color = { 0.22 , 0.22 , 0.11 , 1.0 }

[floor]
UUID = 14382231788964811176
