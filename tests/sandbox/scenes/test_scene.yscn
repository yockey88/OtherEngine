#[
  primary sandbox scene
#]

[metadata]
name = "test_scene"
entities = {
  "cube" ,
  "sun" ,
  "floor",
  "camera",
  "backpack",
}


[physics.2D]
gravity = { 0 , -9.8 }

[physics.3D]


[cube]
UUID = 12461263173642597452
components = {
  static-mesh , 
  script,
  rigid-body,
  collider
}

[cube.transform]
position = { 0 , 0 , 0 }
rotation = { 0 , 0 , 0 , 0 }
scale = { 1 , 1 , 1 }

[cube.relationship]
children = {}

[cube.static-mesh]
visible = true
is-primitive = true
primitive = 3
material.albedo = { 0, 1, 0, 1 },
material.normal = { 1.0 , 1.0 , 1.0, 1 },
material.roughness = { 1.0, 1.0, 1.0, 1 }

[cube.script]
*SandboxScripts = { "Other::TestScript2" }

[cube.rigid-body]
type = "dynamic"

[cube.collider]
shape = box

[sun]
UUID = 4025795962345870502
components = {
  light-source
}

[sun.transform]
position = { -1.0 , 1.0 , -1.0 } 
rotation = { 0 , 0 , 0 , 0 }
scale = { 0.2 , 0.2 , 0.2 }

[sun.light-source]
type = 0
direction = { 2.0 , -4.0 , 1.0 , 1.0 }
color = { 0.22 , 0.22 , 0.11 , 1.0 }

[floor]
UUID = 14382231788964811176
components = {
  static-mesh,
  script,
  rigid-body,
  collider,
}

[floor.transform]
position = { 0 , -2 , 0 }
rotation = { 0 , 0 , 0 , 1 }
scale = { 10 , 1 , 10 }

[floor.relationship]
children = {}

[floor.static-mesh]
visible = true
