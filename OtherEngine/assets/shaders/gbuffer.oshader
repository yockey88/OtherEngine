vertex [mesh : default] {

  void main() {
    mat4 model = models[gl_InstanceID];
    foe_material = materials[gl_InstanceID];

    vec4 world_pos = model * vec4(voe_position , 1.0);
    foe_position = world_pos.xyz;
    instanceid = gl_InstanceID;

    mat3 normal_mat = transpose(inverse(mat3(model)));
    foe_normal = normal_mat * voe_normal;
    foe_uvs = voe_uvs;

    gl_Position = projection * view * world_pos;
  }

}

fragment {
  
  void main() {
    g_position = vec4(foe_position , 1.0);
    g_normal = vec4(normalize(foe_normal) , 1.0);
    g_albedo.rgb = texture(albedo_textures, vec3(foe_uvs, instanceid)).rgb;
    g_albedo.a = 32.0;
  }

}
