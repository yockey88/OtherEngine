vertex {

  layout (location = 0) in vec3 position;
  layout (location = 1) in vec3 color;

  out vec4 fcolor;

  void main() {
    gl_Position = projection * view * vec4(position , 1.0);
    fcolor = vec4(color, 1.0);
  }

}

fragment {

  in vec4 fcolor;

  out vec4 FragColor;

  void main() {
    FragColor = fcolor;
  }

}